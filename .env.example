# Copy to .env and edit, or just export these before running.

# --- Demo network -------------------------------------------------------
# 1 = the simulator invents sightings so the dashboard is alive with no real
# data. Everything it creates is tagged is_demo and badged DEMO in the UI.
SPIDEY_DEMO=1
SPIDEY_DEMO_MIN=15
SPIDEY_DEMO_MAX=45

# --- NED AI -------------------------------------------------------------
# Without a key NED runs a deterministic local intent engine and says so.
# With one it uses the Claude API with tool calling over live app state.
# ANTHROPIC_API_KEY=sk-ant-...
SPIDEY_AI_MODEL=claude-sonnet-5

# --- Storage ------------------------------------------------------------
# SPIDEY_DB=./data/spidey.db
# SPIDEY_UPLOADS=./data/uploads
SPIDEY_MAX_UPLOAD_MB=16

# --- Prediction engine --------------------------------------------------
SPIDEY_PRED_HORIZON=12
SPIDEY_PRED_LOOKBACK=180
SPIDEY_ACTIVE_WINDOW=30

# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
SPIDEY_SECRET_KEY=change-me-in-production
